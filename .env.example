# ==============================================================================
# GroundedCVE Environment Configuration
# Copy this file to .env and configure your secrets / endpoints.
# (.env is gitignored and will never be committed)
# ==============================================================================

# OpenRouter API (Cloud LLM Gateway - e.g., Qwen 2.5 72B Instruct)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Local Ollama Endpoint (Default fallback if OpenRouter is unconfigured)
OLLAMA_HOST=http://localhost:11434
DEFAULT_AI_MODEL=qwen2.5:3b

# Optional API Keys for Live Feeds (Increases rate limits)
NVD_API_KEY=
GITHUB_TOKEN=

# Qdrant Vector DB Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
