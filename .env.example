# ==============================================================================
# GroundedCVE Environment Configuration
# Copy this file to .env and configure your secrets / endpoints.
# (.env is gitignored and will never be committed)
# ==============================================================================

# OpenRouter API (Cloud LLM Gateway - e.g., Qwen 2.5 72B Instruct)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Local Ollama Endpoint (Default fallback if OpenRouter is unconfigured)
OLLAMA_HOST=http://localhost:11434
DEFAULT_AI_MODEL=qwen2.5:3b

# Optional API Keys for Live Feeds (Increases rate limits)
NVD_API_KEY=
GITHUB_TOKEN=

# Qdrant Vector DB Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Telegram weekly digest (python Backend/run_telegram_digest.py)
# Bot token from @BotFather. Keep it here only, never in channel_config.json.
TELEGRAM_BOT_TOKEN=
# Your private chat id with the bot, or a channel id (starts with -100)
TELEGRAM_CHAT_ID=
# Address the Telegram links open. Use the PC's Wi-Fi address (e.g. http://192.168.1.20:5000)
# to open links from a phone on the same network.
BASE_URL=http://localhost:5000
