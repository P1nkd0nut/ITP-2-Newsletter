# ==============================================================================
# GroundedCVE Environment Configuration
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# (.env is gitignored and will never be committed)
# ==============================================================================

# --- Required for the newsletter -------------------------------------------
# OpenRouter API key (https://openrouter.ai/keys). Used for AI severity scoring
# and to write the grounded summaries. Without it nothing passes the
# verification gate, so the digest stays empty.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# --- Telegram weekly digest (optional) -------------------------------------
# Bot token from @BotFather. Keep it here only, never in channel_config.json.
TELEGRAM_BOT_TOKEN=
# Your private chat id with the bot, or a channel id (starts with -100)
TELEGRAM_CHAT_ID=
# Address the Telegram links open. Use the PC's Wi-Fi address (e.g. http://192.168.1.20:5000)
# to open links from a phone on the same network.
BASE_URL=http://localhost:5000

# --- Optional API keys for live feeds (higher rate limits) ------------------
NVD_API_KEY=
GITHUB_TOKEN=

# --- Scheduler (docker compose) --------------------------------------------
# Items fetched per source per run
INGEST_LIMIT=5
# Grounded cards written per run
SUMMARY_TOP=10
# Daily pipeline run time (24h clock) and its timezone. It also runs once when Docker starts.
PIPELINE_RUN_TIME=08:00
PIPELINE_TIMEZONE=Asia/Singapore
# Days between Telegram digests
DIGEST_INTERVAL_DAYS=7
# How similar (0-1) a write-up without a CVE ID must be to one already sent to be skipped as a repeat
NOVELTY_SIMILARITY=0.92
# Write summaries with a local Ollama model instead, if OPENROUTER_API_KEY is empty
# (pull it first: docker exec groundedcve-ollama ollama pull qwen2.5:3b)
SUMMARY_OLLAMA_MODEL=

# --- Only used when running outside Docker ---------------------------------
# Inside Docker these are set by docker-compose.yml and the values here are ignored.
OLLAMA_HOST=http://localhost:11434
DEFAULT_AI_MODEL=qwen2.5:3b
QDRANT_HOST=localhost
QDRANT_PORT=6333
