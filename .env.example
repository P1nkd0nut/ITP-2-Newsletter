# ==============================================================================
# GroundedCVE environment configuration (template)
#
#   1. Copy this file:   cp .env.example .env      (Windows: copy .env.example .env)
#   2. Fill in the keys you have. Everything else can stay as it is.
#   3. Restart:          docker compose up -d      (containers read .env when they start)
#
# .env is gitignored. Never commit real keys, and never paste them into
# Backend/data/channel_config.json (that file is in the repository).
# A blank value means "not set": the feature that needs it is skipped and the
# pipeline log says so.
# ==============================================================================


# --- LLM (needed for the newsletter) ------------------------------------------
# OpenRouter key from https://openrouter.ai/keys. Used for:
#   - AI practical severity in triage (falls back to local Ollama, then keyword rules)
#   - writing the grounded cards (no fallback: without a key or SUMMARY_OLLAMA_MODEL
#     no cards are written, nothing passes the gate and the digest stays empty)
OPENROUTER_API_KEY=
# Leave these two as they are unless you move to another OpenRouter model.
# The report's results were produced with qwen/qwen-2.5-72b-instruct.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Write cards with a local Ollama model instead, when OPENROUTER_API_KEY is empty.
# Pull the model first:  docker exec groundedcve-ollama ollama pull qwen2.5:3b
# Small local models fail the verification gate far more often than the 72B model.
SUMMARY_OLLAMA_MODEL=


# --- Telegram weekly digest (optional) ----------------------------------------
# 1. Create a bot with @BotFather in Telegram and paste its token here.
# 2. Add the bot to your channel as an admin with the "Pin Messages" right
#    (the pinned "Edition YYYY-Wnn" header is how other PCs know the week was sent).
# 3. Chat ID: a channel ID starts with -100. To find it, post in the channel and open
#    https://api.telegram.org/bot<token>/getUpdates in a browser.
# Leave both blank to switch the digest off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Address the dashboard is served on, shown as the primary channel in /api/channels.
# Telegram messages never link to it; they carry only public NVD, source and PoC links.
# Outside Docker, leave it blank to use this PC's current network address.
BASE_URL=http://127.0.0.1:5000


# --- Feed API keys (optional, raise rate limits) -------------------------------
# NVD key from https://nvd.nist.gov/developers/request-an-api-key.
# Without one the collector waits about 6 s between NVD requests (1 s with a key),
# which makes the NVD lookups for CISA KEV items slower but still works.
NVD_API_KEY=
# GitHub personal access token (no scopes needed: public repositories only).
# Used by the GitHub PoC search and the GitHub Advisory and Frida collectors.
# Without it GitHub allows 10 searches a minute, so some PoC searches come back
# empty and are tried again on the next run (PoCs already found are kept).
GITHUB_TOKEN=


# --- Scheduler (the "scheduler" container) ------------------------------------
# Items fetched per source per run
INGEST_LIMIT=5
# NVD publishes far more CVEs than the other feeds; take up to this many of the
# newest per run (used only if larger than INGEST_LIMIT)
NVD_LIMIT=20
# Every in-scope item published, first seen or changed in the last 7 days gets a
# card (unchanged cards are reused for free). This caps how many new cards are
# written in one run (about $0.0005 and 10 s each); any left over are written on
# the next run. 0 = no cap.
SUMMARY_TOP=50
# Daily run time (24-hour clock) and its timezone. The pipeline also runs once
# whenever the scheduler container starts.
PIPELINE_RUN_TIME=08:00
PIPELINE_TIMEZONE=Asia/Singapore
# Days between Telegram digests
DIGEST_INTERVAL_DAYS=7
# How similar (0-1) a write-up without a CVE ID must be to one already sent to be
# skipped as a repeat. Leave blank to use the threshold tuned by
# Backend/run_novelty_eval.py (0.92 until it has run).
NOVELTY_SIMILARITY=


# --- Only used when running the Python scripts outside Docker ------------------
# Inside Docker, docker-compose.yml sets these to the qdrant and ollama
# containers and the values here are ignored.
# Docker's Ollama is internal only, so outside Docker these must point at an
# Ollama you run yourself (with nomic-embed-text pulled).
OLLAMA_HOST=http://localhost:11434
QDRANT_HOST=localhost
QDRANT_PORT=6333
